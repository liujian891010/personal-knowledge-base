{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiPage",
  "description": "Logical structure of a compiled AI wiki page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "summary",
    "body_markdown",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outlineItem"
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "note",
            "attachment",
            "search_result",
            "external"
          ]
        },
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "Optional precise location such as heading, page span or timestamp."
        }
      }
    },
    "outlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "level"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    }
  }
}
