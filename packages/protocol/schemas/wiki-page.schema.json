{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiPage",
  "description": "Logical structure of a compiled AI wiki page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "page_type",
    "summary",
    "body_markdown",
    "source_refs",
    "updated_at",
    "ai_generated",
    "user_edited",
    "locked"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "page_type": {
      "type": "string",
      "enum": [
        "topic",
        "entity",
        "timeline",
        "qa",
        "summary"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outlineItem"
      }
    },
    "related_pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relatedPage"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "user_edited": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean"
    },
    "last_ai_compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_compiled_from_sources_hash": {
      "type": "string",
      "minLength": 1
    },
    "last_synced_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "note",
            "attachment",
            "search_result",
            "external"
          ]
        },
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "Optional precise location such as heading, page span or timestamp."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": [
                  "note",
                  "attachment"
                ]
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "file_id",
              "path"
            ]
          }
        }
      ]
    },
    "outlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "level"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "relatedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "path"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
