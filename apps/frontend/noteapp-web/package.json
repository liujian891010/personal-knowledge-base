{
  "name": "noteapp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "validate:sync-shell": "tsx scripts/validate-sync-shell-fixture.mts",
    "validate:settings-snapshot": "tsx scripts/validate-settings-snapshot-fixture.mts",
    "validate:workspace-files": "tsx scripts/validate-workspace-files-fixture.mts",
    "validate:workspace-file-content": "tsx scripts/validate-workspace-file-content-fixture.mts",
    "sync:snapshot": "node scripts/write-live-sync-shell.mjs",
    "settings:snapshot": "node scripts/write-local-settings-snapshot.mjs",
    "settings:write": "node scripts/write-local-settings.mjs",
    "workspace:files": "node scripts/write-workspace-files.mjs",
    "workspace:content": "node scripts/write-workspace-file-content.mjs",
    "sync:action": "node scripts/execute-sync-action.mjs",
    "sync:bridge": "node scripts/sync-shell-bridge.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
