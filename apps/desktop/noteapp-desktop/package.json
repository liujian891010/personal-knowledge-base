{
  "name": "noteapp-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "NoteAI desktop client shell",
  "author": "xgjk",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:frontend": "node scripts/build-frontend.mjs",
    "pack:win": "npm.cmd run build:frontend && node scripts/package-win.mjs --dir --win nsis",
    "dist:win": "npm.cmd run build:frontend && node scripts/package-win.mjs --win nsis",
    "dist:win:signed": "npm.cmd run build:frontend && node scripts/check-win-signing-env.mjs && node scripts/package-win.mjs --win nsis && node scripts/verify-win-signature.mjs",
    "verify:win-signature": "node scripts/verify-win-signature.mjs",
    "pack:mac": "npm run build:frontend && node scripts/package-mac.mjs --dir --mac",
    "dist:mac": "npm run build:frontend && node scripts/package-mac.mjs --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.xgjk.noteapp.desktop",
    "productName": "NoteAI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/noteapp-web/dist",
        "to": "bundle/apps/frontend/noteapp-web/dist"
      },
      {
        "from": "../../frontend/noteapp-web/scripts",
        "to": "bundle/apps/frontend/noteapp-web/scripts"
      },
      {
        "from": "../../../clients",
        "to": "bundle/clients",
        "filter": [
          "desktop/**/*",
          "__init__.py"
        ]
      },
      {
        "from": "../../../packages/ai-core",
        "to": "bundle/packages/ai-core",
        "filter": [
          "src/**/*"
        ]
      },
      {
        "from": "../../../packages/vault-core",
        "to": "bundle/packages/vault-core",
        "filter": [
          "src/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
