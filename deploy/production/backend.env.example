# Copy this file to backend.env and fill deployment-specific values.
# Do not commit backend.env.

NOTEAPP_SERVER_ENV=production
NOTEAPP_SERVER_DATA_DIR=/var/lib/noteapp-server/runtime
NOTEAPP_SERVER_STORAGE=sqlite
NOTEAPP_SERVER_DATABASE_URL=sqlite:////var/lib/noteapp-server/db/noteapp-server.sqlite3
NOTEAPP_SERVER_SQLITE_BACKUP_DIR=/var/backups/noteapp-server

# Current server profile stores opaque sessions server-side, but reserve a strong
# secret for future signed-token profiles and operational rotation.
NOTEAPP_SERVER_TOKEN_SIGNING_SECRET=replace-with-secret-manager-value

NOTEAPP_SERVER_BLOB_STORAGE=s3
NOTEAPP_SERVER_OBJECT_ENDPOINT=https://s3.example.com
NOTEAPP_SERVER_OBJECT_BUCKET=noteapp-vault-blobs
NOTEAPP_SERVER_OBJECT_REGION=us-east-1
NOTEAPP_SERVER_OBJECT_ACCESS_KEY_ID=replace-with-secret-manager-value
NOTEAPP_SERVER_OBJECT_SECRET_ACCESS_KEY=replace-with-secret-manager-value
NOTEAPP_SERVER_OBJECT_CREDENTIAL_ROTATION_DAYS=90
NOTEAPP_SERVER_OBJECT_LIFECYCLE_RETENTION_DAYS=365
NOTEAPP_SERVER_OBJECT_ALERT_DESTINATION=ops-object-storage
NOTEAPP_SERVER_OBJECT_LEAST_PRIVILEGE_POLICY=single-bucket-read-write

NOTEAPP_SERVER_TOMBSTONE_GC_WORKER_ENABLED=true
NOTEAPP_SERVER_TOMBSTONE_GC_INTERVAL_MS=3600000
NOTEAPP_SERVER_TOMBSTONE_GC_MIN_RETENTION_MS=604800000
NOTEAPP_SERVER_TOMBSTONE_GC_INACTIVE_AFTER_MS=604800000

NOTEAPP_SERVER_CAS_LOCK_STRATEGY=sqlite-immediate
NOTEAPP_SERVER_CAS_CONFLICT_RATE_ALERT_THRESHOLD=0.2
NOTEAPP_SERVER_CAS_STATE_WRITE_CONFLICT_ALERT_THRESHOLD=1
NOTEAPP_SERVER_CAS_LOCK_WAIT_MS_ALERT_THRESHOLD=250
NOTEAPP_SERVER_CAS_ERROR_RATE_ALERT_THRESHOLD=0.05

NOTEAPP_SERVER_CORS_ORIGINS=https://app.example.com
NOTEAPP_SERVER_LOG_LEVEL=INFO

# Docker Compose interpolation only.
NOTEAPP_IMAGE_TAG=v1.0.43
NOTEAPP_SERVER_PORT=8000
